# Non-secret settings. Set the public bind and real certificate identities before starting.
OPENWAF_LISTEN=127.0.0.1:8443
OPENWAF_ADMIN=127.0.0.1:8081
OPENWAF_TRUSTED_PROXIES=
OPENWAF_AUDIT_EXPORT_URL=
OPENWAF_TLS_CERT=/etc/openwaf/tls/current/fullchain.pem
OPENWAF_TLS_KEY=/etc/openwaf/tls/current/privkey.pem
OPENWAF_TLS_HOSTNAMES=application.example.invalid

# Optional non-secret OIDC/passkey settings with a separate protected client-secret file.
OPENWAF_AUTH_CONFIG=
OPENWAF_ADMIN_TLS_CERT=
OPENWAF_ADMIN_TLS_KEY=
